---
import PageHeader from "@components/PageHeader.astro";
import Base from "@layouts/Base.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const project = projects.find((entry) => entry.id === "gambit");
if (!project) {
  throw new Error("Missing projects/gambit entry");
}

const projectHighlights = [
  {
    title: "Opening-first training",
    description:
      "Users can import PGNs and memorize full opening lines with interactive board feedback.",
  },
  {
    title: "Practical tactical work",
    description:
      "Exercises include tactical and positional practice with session-level error awareness.",
  },
  {
    title: "Classroom-ready model",
    description:
      "Virtual classroom workflows support coaches and student groups with shared learning plans.",
  },
];

const capabilityCards = [
  {
    title: "PGN repertoire import",
    details:
      "Players can bring their existing repertoire and transform it into guided memorization routines.",
  },
  {
    title: "Spaced repetition",
    details:
      "Repetition patterns help long-term retention of opening branches and critical ideas.",
  },
  {
    title: "Mistake detection",
    details:
      "Interactive board logic flags wrong moves in real time to accelerate correction loops.",
  },
  {
    title: "Tactical modules",
    details:
      "Session-based puzzle and positional exercises keep training practical and measurable.",
  },
  {
    title: "Virtual classrooms",
    details:
      "Study groups and coach-led lessons bring collaborative structure to online chess prep.",
  },
  {
    title: "Open beta release",
    details:
      "The product is in beta, allowing rapid experimentation while core workflows mature.",
  },
];
---

<Base
  title={project.data.title}
  meta_title={project.data.meta_title}
  description={project.data.description}
  image={project.data.image}
>
  <section class="page-hero pt-16">
    <div class="container">
      <PageHeader page_data={project.data} />

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a
          href="https://gambit.tauideas.com"
          target="_blank"
          rel="noreferrer"
          class="btn btn-primary text-center"
        >
          Visit TauGambit
        </a>
        <a
          href="https://gambit.tauideas.com/register"
          target="_blank"
          rel="noreferrer"
          class="btn btn-outline-primary text-center"
        >
          Create Account
        </a>
        <a
          href="https://gambit.tauideas.com/login"
          target="_blank"
          rel="noreferrer"
          class="btn btn-outline-primary text-center"
        >
          Sign In
        </a>
        <a
          href="https://gambit.tauideas.com/about"
          target="_blank"
          rel="noreferrer"
          class="btn btn-outline-primary text-center"
        >
          About Project
        </a>
      </div>
    </div>
  </section>

  <section class="section pt-8">
    <div class="container">
      <div class="rounded-2xl bg-theme-light p-8 lg:p-12">
        <div class="grid gap-8 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <h2 class="mb-4">Project Snapshot</h2>
            <p>
              TauGambit is a chess training product built around opening
              memorization and tactical consistency. It blends repertoire study,
              interactive correction loops, and classroom scenarios for coached
              or self-directed progression.
            </p>
            <p class="mt-4">
              The current release is beta and clearly communicates that product
              data can change while the platform evolves.
            </p>
          </div>
          <div class="lg:col-span-5">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
              <div class="rounded-xl border border-border bg-white p-5">
                <p class="mb-1 text-sm uppercase tracking-wide text-primary">
                  Domain
                </p>
                <p class="mb-0 font-semibold text-dark">Chess training SaaS</p>
              </div>
              <div class="rounded-xl border border-border bg-white p-5">
                <p class="mb-1 text-sm uppercase tracking-wide text-primary">
                  Audience
                </p>
                <p class="mb-0 font-semibold text-dark">
                  Learners, coaches, study groups
                </p>
              </div>
              <div class="rounded-xl border border-border bg-white p-5">
                <p class="mb-1 text-sm uppercase tracking-wide text-primary">
                  Release Stage
                </p>
                <p class="mb-0 font-semibold text-dark">Public beta</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-4">
    <div class="container">
      <div class="mb-10 max-w-2xl">
        <h2>Why This Project Works</h2>
        <p>
          TauGambit targets one of the hardest parts of chess improvement:
          retaining prepared lines while converting them into practical board
          performance.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {projectHighlights.map((item) => (
          <article class="rounded-xl border border-border p-6 shadow-sm">
            <h3 class="mb-3 h5">{item.title}</h3>
            <p class="mb-0">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section pt-4">
    <div class="container">
      <div class="mb-10 max-w-3xl">
        <h2>Core Capabilities</h2>
        <p>
          The live beta already exposes a clear educational engine with room for
          rapid iteration.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {capabilityCards.map((card) => (
          <article class="rounded-xl bg-white p-6 shadow-[0_8px_28px_rgba(0,0,0,0.07)]">
            <h3 class="mb-3 h5">{card.title}</h3>
            <p class="mb-0">{card.details}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section pt-4">
    <div class="container">
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-border p-8">
          <h2 class="mb-4">User Journey</h2>
          <ol class="mb-0 list-decimal space-y-3 pl-5 text-text">
            <li>Create account and define chess training goals.</li>
            <li>Import opening PGNs and start interactive rehearsal.</li>
            <li>Run tactical sessions and track recurring mistakes.</li>
            <li>Join or create virtual classroom study groups.</li>
            <li>Iterate training using repetition and coach feedback.</li>
          </ol>
        </div>

        <div class="rounded-2xl border border-border p-8">
          <h2 class="mb-4">Growth Opportunities</h2>
          <ul class="mb-0 list-disc space-y-3 pl-5 text-text">
            <li>Add progress dashboards by opening family and tactic themes.</li>
            <li>Introduce coach analytics for student-level weaknesses.</li>
            <li>Expand onboarding templates by rating range.</li>
            <li>Add spaced-review reminders and calendar workflows.</li>
            <li>Harden beta UX for long-term production readiness.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-4">
    <div class="container">
      <div class="rounded-2xl bg-dark px-8 py-12 text-white lg:px-12">
        <p class="mb-3 text-sm uppercase tracking-[0.2em] text-white/75">
          Project Summary
        </p>
        <h2 class="mb-4 text-white">TauGambit trains opening precision</h2>
        <p class="mb-8 text-white/80">
          A beta chess-learning product focused on repertoire retention,
          tactical rigor, and collaborative training between players and
          coaches.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="https://gambit.tauideas.com"
            target="_blank"
            rel="noreferrer"
            class="btn btn-primary"
          >
            Open TauGambit
          </a>
          <a
            href="/projects"
            class="btn border border-white/30 bg-transparent text-white hover:border-white hover:text-white"
          >
            Back to Projects
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
